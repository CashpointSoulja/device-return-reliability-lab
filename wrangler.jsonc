{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "device-return-reliability-lab",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {"directory":"./dist", "binding":"ASSETS", "run_worker_first":["/api/*"]},
  "durable_objects": {"bindings":[{"name":"SESSIONS", "class_name":"ReturnSession"}]},
  "migrations": [{"tag":"v1", "new_sqlite_classes":["ReturnSession"]}],
  "observability": {"enabled":false}
}
